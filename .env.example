# Copy this file to .env.local and fill in what you need.
# .env.local is ignored by git — never commit real keys.

# Public base URL of the site (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Search engine indexing. Keep "false" for the fictional demo so search
# engines don't index a non-existent clinic. Set "true" for a real client site.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Optional: Google Maps Embed API key. If empty, a key-less Google Maps embed
# is used. Embed keys are visible in the browser by design — restrict this key
# to your domain (HTTP referrer) in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Optional analytics / marketing IDs. These scripts load ONLY after the
# visitor gives consent in the cookie banner.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Optional, SERVER-SIDE ONLY: where booking requests are forwarded
# (e.g. an n8n / Make / CRM webhook). Leave empty for the demo — requests
# are validated and then discarded.
BOOKING_WEBHOOK_URL=
BOOKING_WEBHOOK_SECRET=
